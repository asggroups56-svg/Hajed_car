+/// One bank financing offer shown in the home financing offers slider.
+class FinancingOfferCardWidget extends StatelessWidget {
+  const FinancingOfferCardWidget({super.key, required this.offer, this.onTap});
+
+  final FinancingAdModel offer;
+  final VoidCallback? onTap;
+
+  String _bankName(BuildContext context) {
+    final localizedName = context.locale.languageCode == 'en'
+        ? offer.bankNameEng
+        : offer.bankName;
+    final candidates = [
+      localizedName,
+      offer.bankName,
+      offer.bankNameEng,
+      offer.displayBankName,
+      offer.bankOrProvider,
+    ];
+    for (final candidate in candidates) {
+      final name = candidate?.trim();
+      if (name != null && name.isNotEmpty) return name;
+    }
+    return '';
+  }
+
+  String _offerTitle(BuildContext context) {
+    final candidates = [offer.programName, offer.itemName, offer.modelName];
+    for (final candidate in candidates) {
+      final title = candidate?.trim();
+      if (title != null && title.isNotEmpty) return title;
+    }
+    return AppLocaleKey.financingOfferFallback.tr();
+  }
+
+  String _monthlyInstallment(BuildContext context) {
+    final installment = offer.monthlyInstallmentWithVat;
+    if (installment <= 0) return '—';
+    return NumberFormat(
+      '#,##0',
+      context.locale.languageCode,
+    ).format(installment);
+  }
+
+  Widget _buildBankLogo(BuildContext context) {
+    final fallback = _BankLogoFallback(name: _bankName(context));
+    final logoUrl = offer.displayBankImageUrl;
+    if (logoUrl == null || logoUrl.isEmpty) return fallback;
+    return CustomNetworkImage(
+      imageUrl: logoUrl,
+      width: 30.w,
+      height: 30.w,
+      radius: 8.r,
+      fit: BoxFit.contain,
+      errorWidget: fallback,
+    );
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return GestureDetector(
+      onTap: onTap,
+      child: Container(
+        width: 210.w,
+        padding: EdgeInsets.all(12.w),
+        decoration: BoxDecoration(
+          color: AppColor.cardColor(context),
+          borderRadius: BorderRadius.circular(16.r),
+          border: Border.all(
+            color: AppColor.borderColor(context).withValues(alpha: 0.6),
+          ),
+          boxShadow: [
+            BoxShadow(
+              color: AppColor.blackColor(context).withValues(alpha: 0.05),
+              blurRadius: 10,
+              offset: const Offset(0, 4),
+            ),
+          ],
+        ),
+        child: Column(
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            Row(
+              children: [
+                _buildBankLogo(context),
+                Gap(8.w),
+                Expanded(
+                  child: Text(
+                    _bankName(context),
+                    maxLines: 1,
+                    overflow: TextOverflow.ellipsis,
+                    style: AppTextStyle.bodySmall(context).copyWith(
+                      color: AppColor.greyColor(context),
+                      fontWeight: FontWeight.w600,
+                    ),
+                  ),
+                ),
+              ],
+            ),
+            Gap(10.h),
+            Text(
