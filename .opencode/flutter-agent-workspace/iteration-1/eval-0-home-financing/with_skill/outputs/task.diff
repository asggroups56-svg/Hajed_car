+/// Horizontal financing offers section shown under the home ads slider.
+///
+/// The offers are already fetched by [HomeCubit.refreshHomeData]; this widget
+/// only renders the [HomeState.financingAdsStatus] it receives.
+class FinancingOffersSectionWidget extends StatelessWidget {
+  const FinancingOffersSectionWidget({super.key});
+
+  void _openFinancing(
+    BuildContext context,
+    FinancingAdModel offer,
+    List<FinancingAdModel> offers,
+  ) {
+    NavigatorMethods.pushNamed(
+      context,
+      RoutesName.financingScreen,
+      arguments: {
+        'car': offer.toCarDataModel(),
+        'offer': offer,
+        'offers': offers,
+      },
+    );
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return BlocBuilder<HomeCubit, HomeState>(
+      buildWhen: (previous, current) =>
+          previous.financingAdsStatus != current.financingAdsStatus,
+      builder: (context, state) {
+        return Column(
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            SectionTitleWidget(
+              title: AppLocaleKey.financingOffersSectionTitle.tr(),
+            ),
+            Gap(10.h),
+            _buildBody(context, state.financingAdsStatus),
+          ],
+        );
+      },
+    );
+  }
+
+  Widget _buildBody(
+    BuildContext context,
+    StatusState<List<FinancingAdModel>> status,
+  ) {
+    if (status.isInitial || status.isLoading) {
+      return const _FinancingOffersLoadingPlaceholder();
+    }
+
+    if (status.isFailure) {
+      return ExceptionWidget(
+        axis: Axis.horizontal,
+        message: status.error,
+        onReload: () => context.read<HomeCubit>().getFinancingAds(),
+      );
+    }
+
+    final offers = status.data ?? const <FinancingAdModel>[];
+    if (offers.isEmpty) {
+      return NoDataWidget(
+        axis: Axis.horizontal,
+        message: AppLocaleKey.financingOffersEmpty.tr(),
+      );
+    }
+
+    return SizedBox(
+      height: 168.h,
+      child: ListView.separated(
+        scrollDirection: Axis.horizontal,
+        physics: const BouncingScrollPhysics(),
+        padding: EdgeInsets.symmetric(vertical: 4.h),
+        itemCount: offers.length,
+        separatorBuilder: (context, index) => Gap(12.w),
+        itemBuilder: (context, index) {
+          final offer = offers[index];
+          return FinancingOfferCardWidget(
+            key: ValueKey('financing_offer_${offer.programId ?? index}'),
+            offer: offer,
+            onTap: () => _openFinancing(context, offer, offers),
+          );
+        },
+      ),
+    );
+  }
+}
+
+class _FinancingOffersLoadingPlaceholder extends StatelessWidget {
+  const _FinancingOffersLoadingPlaceholder();
+
+  @override
+  Widget build(BuildContext context) {
+    return SizedBox(
+      height: 168.h,
+      child: ListView.separated(
+        scrollDirection: Axis.horizontal,
+        physics: const NeverScrollableScrollPhysics(),
+        padding: EdgeInsets.symmetric(vertical: 4.h),
+        itemCount: 3,
+        separatorBuilder: (context, index) => Gap(12.w),
+        itemBuilder: (context, index) => Container(
+          width: 210.w,
+          padding: EdgeInsets.all(12.w),
+          decoration: BoxDecoration(
+            color: AppColor.cardColor(context),
+            borderRadius: BorderRadius.circular(16.r),
+            border: Border.all(
+              color: AppColor.borderColor(context).withValues(alpha: 0.6),
+            ),
+          ),
+          child: Column(
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              Row(
+                children: [
+                  CustomShimmer(width: 30.w, height: 30.w, radius: 8.r),
+                  Gap(8.w),
+                  CustomShimmer(width: 90.w, height: 12.h, radius: 6.r),
+                ],
+              ),
+              Gap(14.h),
+              CustomShimmer(width: 150.w, height: 14.h, radius: 6.r),
+              Gap(8.h),
+              CustomShimmer(width: 110.w, height: 14.h, radius: 6.r),
+              const Spacer(),
+              CustomShimmer(width: 70.w, height: 10.h, radius: 5.r),
+              Gap(6.h),
+              CustomShimmer(width: 100.w, height: 18.h, radius: 6.r),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+}
