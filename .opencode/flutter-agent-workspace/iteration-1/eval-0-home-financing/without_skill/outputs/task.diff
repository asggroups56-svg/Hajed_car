+/// Compact card for one financing programme shown on the guest home screen.
+class FinancingOfferCardWidget extends StatelessWidget {
+  const FinancingOfferCardWidget({
+    super.key,
+    required this.offer,
+    this.offers = const [],
+  });
+
+  final FinancingAdModel offer;
+  final List<FinancingAdModel> offers;
