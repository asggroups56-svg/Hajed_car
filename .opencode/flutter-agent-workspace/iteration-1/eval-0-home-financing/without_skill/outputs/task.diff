+
+  void _openFinancingScreen(BuildContext context) {
+    NavigatorMethods.pushNamed(
+      context,
+      RoutesName.financingScreen,
+      arguments: {
+        'car': offer.toCarDataModel(),
+        'offer': offer,
+        'offers': offers,
+      },
+    );
+  }
+
+  String _firstNonEmpty(List<String?> values) {
+    for (final value in values) {
+      final trimmed = value?.trim() ?? '';
+      if (trimmed.isNotEmpty) return trimmed;
+    }
+    return '';
+  }
+
+  String _bankName(BuildContext context) {
+    final isEnglish = context.locale.languageCode == 'en';
+    return _firstNonEmpty(
+      isEnglish
+          ? [
+              offer.bankNameEng,
+              offer.displayBankName,
+              offer.bankName,
+              offer.bankOrProvider,
+            ]
+          : [
+              offer.displayBankName,
+              offer.bankName,
+              offer.bankNameEng,
+              offer.bankOrProvider,
+            ],
+    );
+  }
+
+  String _offerTitle(BuildContext context) {
+    final title = _firstNonEmpty([
+      offer.programName,
+      offer.itemName,
+      offer.modelName,
+      offer.bankName,
+      offer.bankNameEng,
+    ]);
+    return title.isEmpty
+        ? AppLocaleKey.financingOfferFallbackTitle.tr()
+        : title;
+  }
+
+  double? _monthlyInstallment() {
+    if ((offer.price ?? 0) <= 0) return null;
+    final installment = offer.monthlyInstallmentWithVat;
+    return installment > 0 ? installment : null;
+  }
+
+  Widget _buildBankBadge(BuildContext context, String bankName) {
