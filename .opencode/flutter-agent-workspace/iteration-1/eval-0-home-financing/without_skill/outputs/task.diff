+/// Horizontal financing offers strip shown directly under the home ads
+/// slider. The data is owned and loaded by [HomeCubit]; this widget only
+/// renders the current state.
+class FinancingOffersSection extends StatelessWidget {
+  const FinancingOffersSection({super.key});
+
+  List<FinancingAdModel> _uniqueOffers(List<FinancingAdModel> ads) {
+    final seenProgramIds = <int>{};
+    final offers = <FinancingAdModel>[];
+
+    for (final ad in ads) {
+      final programId = ad.programId;
+      if (programId != null && !seenProgramIds.add(programId)) continue;
+      offers.add(ad);
+    }
+
+    return offers;
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return BlocBuilder<HomeCubit, HomeState>(
+      buildWhen: (previous, current) =>
+          previous.financingAdsStatus != current.financingAdsStatus,
+      builder: (context, state) {
+        final status = state.financingAdsStatus;
+        final offers = status.isSuccess
+            ? _uniqueOffers(status.data ?? const [])
+            : const <FinancingAdModel>[];
+
+        return Column(
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            SectionTitleWidget(title: AppLocaleKey.financingOffersTitle.tr()),
+            Gap(10.h),
+            if (status.isInitial || status.isLoading)
+              const _FinancingOffersLoadingPlaceholder()
+            else if (status.isFailure)
+              _FinancingOffersMessageCard(
+                icon: Icons.cloud_off_rounded,
+                iconColor: AppColor.redColor(context),
+                message: AppLocaleKey.financingOffersError.tr(),
+                action: TextButton(
+                  onPressed: () => context.read<HomeCubit>().getFinancingAds(),
+                  child: Text(
+                    AppLocaleKey.retry.tr(),
+                    style: AppTextStyle.bodySmall(context).copyWith(
+                      color: AppColor.primaryColor(context),
+                      fontWeight: FontWeight.w700,
+                    ),
+                  ),
+                ),
+              )
+            else if (offers.isEmpty)
+              _FinancingOffersMessageCard(
+                icon: Icons.account_balance_outlined,
+                iconColor: AppColor.greyColor(context),
+                message: AppLocaleKey.financingOffersEmpty.tr(),
+              )
+            else
+              SizedBox(
+                height: FinancingOfferCardWidget.cardHeight.h,
+                child: ListView.separated(
+                  scrollDirection: Axis.horizontal,
+                  physics: const BouncingScrollPhysics(),
+                  padding: EdgeInsets.zero,
+                  itemCount: offers.length,
+                  separatorBuilder: (_, _) => Gap(12.w),
+                  itemBuilder: (context, index) => FinancingOfferCardWidget(
+                    offer: offers[index],
+                    offers: offers,
+                  ),
+                ),
+              ),
+          ],
+        );
+      },
+    );
+  }
+}
+
