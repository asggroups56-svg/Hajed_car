+++ b/lib/features/home/presentation/view/widgets/banks_section_widget.dart
+import 'dart:async';
+
+import 'package:car/core/custom_widgets/custom_loading/custom_loading.dart';
+import 'package:car/core/custom_widgets/exception_widget/exception_widget.dart';
+import 'package:car/core/custom_widgets/no_data_widget/no_data_widget.dart';
+import 'package:car/core/localization/app_locale_keys.dart';
+import 'package:car/features/home/data/model/banks_data_model.dart';
+import 'package:car/features/home/presentation/cubit/home_cubit.dart';
+import 'package:car/features/home/presentation/view/widgets/banks_search_field_widget.dart';
+import 'package:car/features/home/presentation/view/widgets/banks_slider_widget.dart';
+import 'package:easy_localization/easy_localization.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_bloc/flutter_bloc.dart';
+import 'package:flutter_screenutil/flutter_screenutil.dart';
+import 'package:gap/gap.dart';
+
+class BanksSectionWidget extends StatefulWidget {
+  const BanksSectionWidget({super.key});
+
+  @override
+  State<BanksSectionWidget> createState() => _BanksSectionWidgetState();
+}
+
+class _BanksSectionWidgetState extends State<BanksSectionWidget> {
+  static const Duration _debounceDuration = Duration(milliseconds: 400);
+
+  final TextEditingController _searchController = TextEditingController();
+  Timer? _debounce;
+
+  @override
+  void dispose() {
+    _debounce?.cancel();
+    _searchController.dispose();
+    super.dispose();
+  }
+
+  void _onQueryChanged(String value) {
+    // Rebuild so the clear button reflects the field content.
+    setState(() {});
+    _debounce?.cancel();
+
+    // Clearing the field should restore all banks immediately.
+    if (value.trim().isEmpty) {
+      _runSearch('');
+      return;
+    }
+
+    _debounce = Timer(_debounceDuration, () {
+      if (!mounted) return;
+      _runSearch(value);
+    });
+  }
+
+  void _onSubmitted(String value) {
+    _debounce?.cancel();
+    _runSearch(value);
+  }
+
+  void _clearSearch() {
+    _debounce?.cancel();
+    _searchController.clear();
+    setState(() {});
+    _runSearch('');
+  }
+
+  void _runSearch(String value) {
+    context.read<HomeCubit>().searchBanks(value);
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.start,
+      children: [
+        BanksSearchFieldWidget(
+          controller: _searchController,
+          hintText: AppLocaleKey.searchBanksHint.tr(),
+          clearTooltip: AppLocaleKey.searchBanksClear.tr(),
+          onChanged: _onQueryChanged,
+          onSubmitted: _onSubmitted,
+          onClear: _clearSearch,
+        ),
+        Gap(8.h),
+        BlocBuilder<HomeCubit, HomeState>(
+          buildWhen: (previous, current) =>
+              previous.banksStatus != current.banksStatus,
+          builder: (context, state) {
+            final status = state.banksStatus;
+
+            if (status.isInitial || status.isLoading) {
+              return SizedBox(
+                height: 40.h,
+                child: const Center(child: CustomLoading(size: 30)),
+              );
+            }
+
+            if (status.isFailure) {
+              return ExceptionWidget(
+                axis: Axis.horizontal,
+                message: status.error,
+                onReload: () => _runSearch(_searchController.text),
+              );
+            }
+
+            final List<BANKSDATAModel> banks = status.data ?? const [];
+            if (banks.isEmpty) {
+              return NoDataWidget(
+                axis: Axis.horizontal,
+                message: AppLocaleKey.noBanksFound.tr(),
+              );
+            }
+
+            return BanksSliderWidget(banks: banks);
+          },
+        ),
+      ],
+    );
+  }
+}
