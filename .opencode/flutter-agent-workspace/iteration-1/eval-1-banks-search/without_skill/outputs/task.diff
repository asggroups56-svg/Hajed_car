+/// Compact banks section for the home screen: a search field above the
+/// existing auto-scrolling banks slider.
+///
+/// The field only forwards the query to [HomeCubit], which debounces it and
+/// calls the banks endpoint. No API call is made from this widget.
+class BanksSearchWidget extends StatefulWidget {
+  const BanksSearchWidget({super.key});
+
+  @override
+  State<BanksSearchWidget> createState() => _BanksSearchWidgetState();
+}
+
+class _BanksSearchWidgetState extends State<BanksSearchWidget> {
+  late final TextEditingController _controller;
+  final FocusNode _focusNode = FocusNode();
+
+  @override
+  void initState() {
+    super.initState();
+    _controller = TextEditingController(
+      text: context.read<HomeCubit>().state.banksSearchQuery,
+    );
+  }
+
+  @override
+  void dispose() {
+    _controller.dispose();
+    _focusNode.dispose();
+    super.dispose();
+  }
+
+  void _onChanged(String value) {
+    context.read<HomeCubit>().onBanksSearchChanged(value);
+    // Rebuilds only to show/hide the clear button as the text changes.
+    setState(() {});
+  }
+
+  void _clearSearch() {
+    _controller.clear();
+    _focusNode.unfocus();
+    context.read<HomeCubit>().clearBanksSearch();
+    setState(() {});
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return BlocBuilder<HomeCubit, HomeState>(
+      buildWhen: (previous, current) =>
+          previous.banksStatus != current.banksStatus ||
+          previous.banksSearchQuery != current.banksSearchQuery,
+      builder: (context, state) {
+        return Column(
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            SectionTitleWidget(title: AppLocaleKey.banks.tr()),
+            Gap(10.h),
+            _SearchField(
+              controller: _controller,
+              focusNode: _focusNode,
+              onChanged: _onChanged,
+              onClear: _clearSearch,
+            ),
+            Gap(12.h),
+            _BanksContent(state: state),
+          ],
+        );
+      },
+    );
+  }
+}
+
+class _SearchField extends StatelessWidget {
+  const _SearchField({
+    required this.controller,
+    required this.focusNode,
+    required this.onChanged,
+    required this.onClear,
+  });
+
+  final TextEditingController controller;
+  final FocusNode focusNode;
+  final ValueChanged<String> onChanged;
+  final VoidCallback onClear;
+
+  @override
+  Widget build(BuildContext context) {
+    final bool hasText = controller.text.isNotEmpty;
+
+    return ConstrainedBox(
+      constraints: BoxConstraints(minHeight: 42.h),
+      child: TextField(
+        controller: controller,
+        focusNode: focusNode,
+        onChanged: onChanged,
+        textInputAction: TextInputAction.search,
+        style: AppTextStyle.bodyMedium(
+          context,
+        ).copyWith(color: AppColor.blackTextColor(context)),
+        decoration: InputDecoration(
+          isDense: true,
+          hintText: AppLocaleKey.banksSearchHint.tr(),
+          hintStyle: AppTextStyle.bodySmall(
+            context,
+          ).copyWith(color: AppColor.greyColor(context)),
+          prefixIcon: Icon(
+            Icons.search_rounded,
+            size: 20.sp,
+            color: AppColor.primaryColor(context),
+          ),
+          prefixIconConstraints: BoxConstraints(
+            minWidth: 38.w,
+            minHeight: 38.h,
+          ),
+          suffixIcon: hasText
+              ? IconButton(
+                  tooltip: AppLocaleKey.banksSearchClear.tr(),
+                  onPressed: onClear,
+                  icon: Icon(
+                    Icons.close_rounded,
+                    size: 18.sp,
+                    color: AppColor.greyColor(context),
+                  ),
+                  splashRadius: 18.r,
+                  padding: EdgeInsets.zero,
+                  constraints: BoxConstraints(minWidth: 36.w, minHeight: 36.h),
+                )
+              : null,
+          suffixIconConstraints: BoxConstraints(
+            minWidth: 36.w,
+            minHeight: 36.h,
+          ),
+          filled: true,
+          fillColor: AppColor.secondAppColor(context),
+          contentPadding: EdgeInsets.symmetric(
+            horizontal: 12.w,
+            vertical: 10.h,
+          ),
+          border: OutlineInputBorder(
+            borderRadius: BorderRadius.circular(12.r),
+            borderSide: BorderSide.none,
+          ),
+          enabledBorder: OutlineInputBorder(
+            borderRadius: BorderRadius.circular(12.r),
+            borderSide: BorderSide(
+              color: AppColor.dividerColor(context).withValues(alpha: .5),
+            ),
+          ),
+          focusedBorder: OutlineInputBorder(
+            borderRadius: BorderRadius.circular(12.r),
+            borderSide: BorderSide(
+              color: AppColor.primaryColor(context),
+              width: 1.5,
+            ),
+          ),
+        ),
+      ),
+    );
+  }
+}
+
+class _BanksContent extends StatelessWidget {
+  const _BanksContent({required this.state});
+
+  final HomeState state;
+
+  @override
+  Widget build(BuildContext context) {
+    final status = state.banksStatus;
+
+    if (status.isInitial || status.isLoading) {
+      return SizedBox(
+        height: 40.h,
+        child: Center(
+          child: SizedBox(
+            width: 18.w,
+            height: 18.w,
+            child: CircularProgressIndicator(
+              strokeWidth: 2,
+              color: AppColor.primaryColor(context),
+            ),
+          ),
+        ),
+      );
+    }
+
+    if (status.isFailure) {
+      return _BanksMessage(
+        icon: Icons.error_outline_rounded,
+        message: AppLocaleKey.banksSearchError.tr(),
+        actionLabel: AppLocaleKey.retry.tr(),
+        onAction: () => context.read<HomeCubit>().getBanks(
+          searchVal: state.banksSearchQuery,
+        ),
+      );
+    }
+
+    final List<BANKSDATAModel> banks = status.data ?? const <BANKSDATAModel>[];
+
+    if (banks.isEmpty) {
+      return _BanksMessage(
+        icon: Icons.account_balance_outlined,
+        message: AppLocaleKey.banksSearchEmpty.tr(),
+      );
+    }
+
+    // The existing banks slider keeps its marquee behaviour.
+    return BanksSliderWidget(banks: banks);
+  }
+}
+
+class _BanksMessage extends StatelessWidget {
+  const _BanksMessage({
+    required this.icon,
+    required this.message,
+    this.actionLabel,
+    this.onAction,
+  });
+
+  final IconData icon;
+  final String message;
+  final String? actionLabel;
+  final VoidCallback? onAction;
+
+  @override
+  Widget build(BuildContext context) {
+    return Container(
+      width: double.infinity,
+      padding: EdgeInsets.symmetric(horizontal: 12.w, vertical: 8.h),
+      decoration: BoxDecoration(
+        color: AppColor.secondAppColor(context),
+        borderRadius: BorderRadius.circular(12.r),
+        border: Border.all(
+          color: AppColor.dividerColor(context).withValues(alpha: .5),
+        ),
+      ),
+      child: Row(
+        children: [
+          Icon(icon, size: 18.sp, color: AppColor.greyColor(context)),
+          Gap(8.w),
+          Expanded(
+            child: Text(
+              message,
+              style: AppTextStyle.bodySmall(
+                context,
+              ).copyWith(color: AppColor.greyColor(context)),
+            ),
+          ),
+          if (actionLabel != null && onAction != null)
+            TextButton(
+              onPressed: onAction,
+              child: Text(
+                actionLabel!,
+                style: AppTextStyle.bodySmall(
+                  context,
+                ).copyWith(color: AppColor.primaryColor(context)),
+              ),
+            ),
+        ],
+      ),
+    );
+  }
+}
