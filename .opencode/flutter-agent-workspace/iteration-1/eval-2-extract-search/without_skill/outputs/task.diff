+/// Search bar + filter button shown at the top of the guest home screen.
+///
+/// Tapping the search bar switches to the cars tab and tapping the filter
+/// button opens the filter screen.
+class HomeSearchFilterWidget extends StatelessWidget {
+  const HomeSearchFilterWidget({super.key});
+
+  @override
+  Widget build(BuildContext context) {
+    return Row(
+      children: [
+        Expanded(
+          child: GestureDetector(
+            onTap: () {
+              // Navigate immediately to cars tab on tap
+              MainLayout.tabIndex.value = 1;
+            },
+            child: AbsorbPointer(
+              child: TextField(
+                readOnly: true,
+                decoration: InputDecoration(
+                  hintText: AppLocaleKey.searchForYourDreamCar.tr(),
+                  hintStyle: AppTextStyle.bodySmall(
+                    context,
+                  ).copyWith(color: AppColor.greyColor(context)),
+                  prefixIcon: Icon(
+                    Icons.search_rounded,
+                    color: AppColor.primaryColor(context),
+                  ),
+                  filled: true,
+                  fillColor: AppColor.secondAppColor(context),
+                  contentPadding: EdgeInsets.symmetric(
+                    horizontal: 16.w,
+                    vertical: 14.h,
+                  ),
+                  border: OutlineInputBorder(
+                    borderRadius: BorderRadius.circular(12.r),
+                    borderSide: BorderSide.none,
+                  ),
+                  enabledBorder: OutlineInputBorder(
+                    borderRadius: BorderRadius.circular(12.r),
+                    borderSide: BorderSide(
+                      color: AppColor.dividerColor(
+                        context,
+                      ).withValues(alpha: .5),
+                    ),
+                  ),
+                  focusedBorder: OutlineInputBorder(
+                    borderRadius: BorderRadius.circular(12.r),
+                    borderSide: BorderSide(
+                      color: AppColor.primaryColor(context),
+                      width: 1.5,
+                    ),
+                  ),
+                ),
+              ),
+            ),
+          ),
+        ),
+        Gap(10.w),
+        // ── Filter button ──────────────────────────────────
+        GestureDetector(
+          onTap: () =>
+              NavigatorMethods.pushNamed(context, RoutesName.filterScreen),
+          child: Container(
+            padding: EdgeInsets.all(14.w),
+            decoration: BoxDecoration(
+              color: AppColor.blackColor(context),
+              borderRadius: BorderRadius.circular(12.r),
+            ),
+            child: Icon(
+              Icons.tune_rounded,
+              color: AppColor.whiteColor(context),
+              size: 22.sp,
+            ),
+          ),
+        ),
+      ],
+    );
+  }
+}
